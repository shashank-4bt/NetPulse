{
  "name": "netpulse",
  "private": true,
  "description": "NetPulse Internet Health Intelligence Platform",
  "scripts": {
    "dev": "npm --prefix netpulse-web run dev",
    "lint": "npm --prefix netpulse-web run lint",
    "typecheck": "npm --prefix netpulse-web run typecheck",
    "test": "npm --prefix netpulse-web run test",
    "test:api": "go -C netpulse-api test ./...",
    "test:all": "npm test && npm run test:api",
    "build": "npm --prefix netpulse-web run build",
    "build:api": "go -C netpulse-api build -o bin/api ./cmd/api && go -C netpulse-api build -o bin/worker ./cmd/worker"
  }
}
