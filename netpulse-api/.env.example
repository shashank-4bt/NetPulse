# API listen address. No secrets belong in this file.
NETPULSE_API_ADDR=:8080
NETPULSE_CORS_ORIGIN=http://localhost:3000
NETPULSE_WORKER_EMBEDDED=true
NETPULSE_WORKER_CONCURRENCY=2
NETPULSE_RATE_LIMIT_PER_MIN=10

# Leave empty to use process-local memory adapters (honest, not production).
NETPULSE_DATABASE_URL=
NETPULSE_REDIS_URL=
NETPULSE_CLICKHOUSE_URL=
