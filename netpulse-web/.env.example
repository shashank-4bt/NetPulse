# Public environment names only. Never put secrets in this file.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side Go API. Leave empty to keep diagnose/status on honest local unavailable.
NETPULSE_API_BASE_URL=

# Leave unset in production. The Go API may echo unused email tokens only when
# NETPULSE_AUTH_DEV_TOKENS=true on the API process.
